  m_text: "\n1. \u0421\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E\u0431 \u0430\u0432\u0442\u043E\u0440\u0430\u0445.
    \r\n\u0421\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u0438: \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0430
    \u041D\u0430\u0442\u0430\u043B\u0438\u044F \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440\u043E\u0432\u043D\u0430
    \u0437\u0430\u0432\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043E\u0442\u0434\u0435\u043B\u043E\u043C
    \u0440\u0435\u0434\u043A\u0438\u0445 \u043A\u043D\u0438\u0433; \u0413\u043E\u0440\u0435\u043B\u043A\u0438\u043D\u0430
    \u041E\u043B\u044C\u0433\u0430 \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440\u043E\u0432\u043D\u0430
    \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430\u0440\u044C
    \u043E\u0442\u0434\u0435\u043B\u0430 \u0440\u0435\u0434\u043A\u0438\u0445 \u043A\u043D\u0438\u0433;
    \u0414\u043C\u0438\u0442\u0440\u0438\u0435\u0432\u0430 \u0422\u0430\u043C\u0430\u0440\u0430
    \u042E\u0440\u044C\u0435\u0432\u043D\u0430 \u0433\u043B\u0430\u0432\u043D\u044B\u0439
    \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430\u0440\u044C \u043E\u0442\u0434\u0435\u043B\u0430
    \u0440\u0435\u0434\u043A\u0438\u0445 \u043A\u043D\u0438\u0433 \u0422\u041E\u0413\u0411\u0423\u041A
    \xAB\u0422\u0430\u043C\u0431\u043E\u0432\u0441\u043A\u0430\u044F \u043E\u0431\u043B\u0430\u0441\u0442\u043D\u0430\u044F
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F
    \u043D\u0430\u0443\u0447\u043D\u0430\u044F \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430
    \u0438\u043C. \u0410. \u0421. \u041F\u0443\u0448\u043A\u0438\u043D\u0430\xBB.\r\n\u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0438:
    \u041A\u043B\u044B\u0433\u0438\u043D\u0430 \u0415\u043B\u0435\u043D\u0430 \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440\u043E\u0432\u043D\u0430
    \u043A.\u043F.\u043D., \u0434\u043E\u0446\u0435\u043D\u0442 \u043A\u0430\u0444\u0435\u0434\u0440\u044B
    \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043C\u043E\u0434\u0435\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u0438 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0439, \u0423\u0442\u043A\u0438\u043D\u0430
    \u041A\u0440\u0438\u0441\u0442\u0438\u043D\u0430 \u0410\u043B\u0435\u043A\u0441\u0435\u0435\u0432\u043D\u0430
    \u0438 \u041F\u0447\u0435\u043B\u0438\u043D\u0446\u0435\u0432 \u0414\u043C\u0438\u0442\u0440\u0438\u0439
    \u0421\u0435\u0440\u0433\u0435\u0435\u0432\u0438\u0447 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u044B
    4 \u043A\u0443\u0440\u0441\u0430 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438 09.03.03 \xAB\u041F\u0440\u0438\u043A\u043B\u0430\u0434\u043D\u0430\u044F
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u0438\u043A\u0430\xBB \u0424\u0413\u0411\u041E\u0423
    \u0412\u041E \xAB\u0422\u0430\u043C\u0431\u043E\u0432\u0441\u043A\u0438\u0439
    \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0438\u043C\u0435\u043D\u0438
    \u0413.\u0420. \u0414\u0435\u0440\u0436\u0430\u0432\u0438\u043D\u0430\xBB\r\n2.
    \u0417\u0430\u0433\u043B\u0430\u0432\u0438\u0435 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0433\u043E
    \u0438\u0437\u0434\u0430\u043D\u0438\u044F \u2013 \u0418\u0441\u0442\u043E\u0440\u0438\u044F
    \u043A\u043D\u0438\u0433\u043E\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u0438\u044F
    \u0432 \u0422\u0430\u043C\u0431\u043E\u0432\u0441\u043A\u043E\u043C \u043A\u0440\u0430\u0435\r\n3.
    \u041F\u043E\u0434\u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043E\u0447\u043D\u044B\u0435
    \u0434\u0430\u043D\u043D\u044B\u0435 \u2013 \u041C\u0443\u043B\u044C\u0442\u0438\u043C\u0435\u0434\u0438\u0439\u043D\u043E\u0435
    \u0438\u0437\u0434\u0430\u043D\u0438\u0435; \r\n4. \u0412\u044B\u0445\u043E\u0434\u043D\u044B\u0435
    \u0434\u0430\u043D\u043D\u044B\u0435  \u2013 \u0422\u0430\u043C\u0431\u043E\u0432,
    2024\u0433.;\r\n5. \u0412\u044B\u043F\u0443\u0441\u043A\u043D\u044B\u0435 \u0434\u0430\u043D\u043D\u044B\u0435
    \u2013 \u0422\u0430\u043C\u0431\u043E\u0432\u0441\u043A\u0438\u0439 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0438\u043C\u0435\u043D\u0438
    \u0413.\u0420. \u0414\u0435\u0440\u0436\u0430\u0432\u0438\u043D\u0430, 392000
    \u0433. \u0422\u0430\u043C\u0431\u043E\u0432, \u0443\u043B. \u041A\u043E\u043C\u0441\u043E\u043C\u043E\u043B\u044C\u0441\u043A\u0430\u044F
    \u043F\u043B\u043E\u0449\u0430\u0434\u044C, 5; \u0422\u041E\u0413\u0411\u0423\u041A
    \xAB\u0422\u0430\u043C\u0431\u043E\u0432\u0441\u043A\u0430\u044F \u043E\u0431\u043B\u0430\u0441\u0442\u043D\u0430\u044F
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F
    \u043D\u0430\u0443\u0447\u043D\u0430\u044F \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430
    \u0438\u043C. \u0410. \u0421. \u041F\u0443\u0448\u043A\u0438\u043D\u0430\xBB,
    392036 \u0433. \u0422\u0430\u043C\u0431\u043E\u0432, \u0443\u043B. \u0418\u043D\u0442\u0435\u0440\u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u0430\u044F
    \u0434. 17 e-mail: tambovlib@gmail.com;\r\n 6. \u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0435
    \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0435 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F
    - \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440 \u2013 Intel Core i3,
    \u0436\u0451\u0441\u0442\u043A\u0438\u0439 \u0434\u0438\u0441\u043A \u0441 \u043E\u0431\u044A\u0435\u043C\u043E\u043C
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0439 \u043F\u0430\u043C\u044F\u0442\u0438
    \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 2 \u0413\u0431, \u041E\u0417\u0423
    \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 4 \u0413\u0431, USB-\u043F\u043E\u0440\u0442,
    \u043C\u043E\u043D\u0438\u0442\u043E\u0440, \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0430,
    \u043C\u044B\u0448\u044C. \u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430
    \u043C\u043E\u0436\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u043F\u043E\u0434 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C
    \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B
    Windows 10.\r\n\r\n7. \u0417\u043D\u0430\u043A \u043E\u0445\u0440\u0430\u043D\u044B
    \u0430\u0432\u0442\u043E\u0440\u0441\u043A\u043E\u0433\u043E \u043F\u0440\u0430\u0432\u0430
    \u2013 \xA9 \u0424\u0413\u0411\u041E\u0423 \u0412\u041E \xAB\u0422\u0430\u043C\u0431\u043E\u0432\u0441\u043A\u0438\u0439
    \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442 \u0438\u043C\u0435\u043D\u0438
    \u0413.\u0420. \u0414\u0435\u0440\u0436\u0430\u0432\u0438\u043D\u0430\xBB, \xA9
    \u0422\u041E\u0413\u0411\u0423\u041A \xAB\u0422\u0430\u043C\u0431\u043E\u0432\u0441\u043A\u0430\u044F
    \u043E\u0431\u043B\u0430\u0441\u0442\u043D\u0430\u044F \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F
    \u043D\u0430\u0443\u0447\u043D\u0430\u044F \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430
    \u0438\u043C. \u0410. \u0421. \u041F\u0443\u0448\u043A\u0438\u043D\u0430\xBB;
    2024\u0433.\r\n8. \u0411\u0438\u0431\u043B\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u2013 \u042D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0435
    \u0438\u0437\u0434\u0430\u043D\u0438\u0435 /\u0422\u0430\u043C\u0431. \u0433\u043E\u0441.
    \u0443\u043D-\u0442 \u0438\u043C. \u0413.\u0420.\u0414\u0435\u0440\u0436\u0430\u0432\u0438\u043D\u0430;
    \u0422\u041E\u0413\u0411\u0423\u041A \xAB\u0422\u0430\u043C\u0431\u043E\u0432\u0441\u043A\u0430\u044F
    \u043E\u0431\u043B\u0430\u0441\u0442\u043D\u0430\u044F \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F
    \u043D\u0430\u0443\u0447\u043D\u0430\u044F \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430
    \u0438\u043C. \u0410. \u0421. \u041F\u0443\u0448\u043A\u0438\u043D\u0430\xBB;
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0438 \u2013
    \u0415.\u0412. \u041A\u043B\u044B\u0433\u0438\u043D\u0430, \u041A.\u0410. \u0423\u0442\u043A\u0438\u043D\u0430,
    \u0414.\u0421. \u041F\u0447\u0435\u043B\u0438\u043D\u0446\u0435\u0432 \u2013
    \u042D\u043B\u0435\u043A\u0442\u0440\u043E\u043D.\u0434\u0430\u043D. \u2013 \u0422\u0430\u043C\u0431\u043E\u0432,
    2024. - 1 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D. \u043E\u043F\u0442.
    \u0434\u0438\u0441\u043A (CD-R): \u0437\u0432.,\u0446\u0432 \u0421\u0438\u0441\u0442\u0435\u043C.
    \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F: \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440
    - Intel i3, \u0436\u0451\u0441\u0442\u043A\u0438\u0439 \u0434\u0438\u0441\u043A
    \u0441 \u043E\u0431\u044A\u0435\u043C\u043E\u043C \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0439
    \u043F\u0430\u043C\u044F\u0442\u0438 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435
    2 \u0413\u0431, \u041E\u0417\u0423 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435
    4 \u0413\u0431, USB-\u043F\u043E\u0440\u0442, \u043C\u043E\u043D\u0438\u0442\u043E\u0440,
    \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0430, \u043C\u044B\u0448\u044C.
    \u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430 \u043C\u043E\u0436\u0435\u0442
    \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043F\u043E\u0434 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C
